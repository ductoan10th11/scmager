# Safe local/deployment template. Put real values only in the approved secret store.
NODE_ENV=development
APP_ROLE=api
MONGO_URI=mongodb://localhost:27017/ework
JWT_SECRET=replace-with-a-random-32-character-minimum-value
SECRET_PROVIDER=env
# Each Connector references one env secret. The value is JSON, never entered in the UI.
# org-a-eoffice={"username":"service-account","password":"replace-me"}
IMAGE_TAG=local
MONGO_INITDB_ROOT_USERNAME=replace-me
MONGO_INITDB_ROOT_PASSWORD=replace-me
